@using Models.BaseModels.Cloak
@using Models.Stats

<MudText Typo="Typo.h6" Style="@($"font-size: large;")">@Cloak.Name</MudText>
<MudText Typo="Typo.subtitle2" Style="@($"color:{Colors.Grey.Darken1};font-style: italic;")">(@Cloak.SimpleName)</MudText>
<br />

<MudItem>
    <MudText Typo="Typo.body1">@Cloak.BaseArmorStat</MudText>
    <MudText Typo="Typo.body1">@Cloak.BaseMagicArmorStat</MudText>
    @foreach (var stat in Cloak.StatCombination.Stats)
    {
        <MudText Typo="Typo.body1" Style="@($"color:{Colors.Green.Darken1};")">@stat</MudText>
    }
    @if (Cloak.StatCombination.StatCombinationType == StatCombinationType.ThreeStats)
    {
        <MudText Typo="Typo.body1" Style="@($"white-space: pre-wrap;")">@Environment.NewLine</MudText>
    }
</MudItem>

@code {
    [Parameter]
    public Cloak Cloak { get; set; }
}