@using Models.BaseModels.Cloak

@inject IDialogService DialogService

<CloakCompressedInfo Cloak="Cloak" />

<br />

<MudButton @onclick="@OpenDialogAsync" Variant="Variant.Outlined" Color="Color.Primary">
    Редактировать
</MudButton>

@code {
    [Parameter]
    public Cloak Cloak { get; set; }

    [Parameter]
    public EventCallback<Cloak> CloakChanged { get; set; }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true};
        var parameters = new DialogParameters<CloakEditDialog> { { x => x.Cloak, Cloak } };

        var dialog = await DialogService.ShowAsync<CloakEditDialog>("Simple Dialog", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var p = (Cloak)result.Data;
            Cloak = p;
            await CloakChanged.InvokeAsync(Cloak);
        }
    }
}