@using Models.BaseModels.Cloak

<MudDialog>
    <TitleContent>
        <DialogHeader @ref="_header" Source="@(() => (Cloak.SimpleName, Cloak.Name, UiText.RarityColor(Cloak.StuffRarity)))" />
    </TitleContent>
    <DialogContent>
        <CloakComponent Cloak="Cloak" CloakChanged="OnCloakChanged"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Cloak Cloak { get; set; }

    private DialogHeader? _header;

    private void OnCloakChanged(Cloak cloak)
    {
        Cloak = cloak;
        _header?.Refresh();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Cloak));
    }

    private void Cancel() => MudDialog.Cancel();
}
