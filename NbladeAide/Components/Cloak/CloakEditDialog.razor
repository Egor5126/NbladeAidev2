@using Models.BaseModels.Cloak

<MudDialog>
    <TitleContent>
        <div class="nb-eyebrow">@Cloak.SimpleName</div>
        <div class="nb-dialog-name" style="color:@UiText.RarityColor(Cloak.StuffRarity)">@Cloak.Name</div>
    </TitleContent>
    <DialogContent>
        <CloakComponent @bind-Cloak="Cloak"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Cloak Cloak { get; set; }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Cloak));
    }

    private void Cancel() => MudDialog.Cancel();
}
