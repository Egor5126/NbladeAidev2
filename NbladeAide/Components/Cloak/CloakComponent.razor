@using Models.Stats
@using Models.BaseModels
@using Models.Multipliers
@using Models.Names
@using Models.BaseModels.Cloak

<div class="nb-edit">
    <div class="nb-edit-main">
        <div class="nb-edit-head">
            <h3 class="nb-edit-title">Характеристики</h3>
            <span class="nb-hint">Диапазон подставляется по редкости и руне</span>
        </div>

        <ManualStatCombinationEditor StatCombination="Cloak.StatCombination"
                                     StatCombinationChanged="UpdateStatCombination"
                                     ScaleMultiplier="@StatScale" />
    </div>

    <div class="nb-edit-side">
        <h3 class="nb-edit-title">Как будет выглядеть в игре</h3>

        <ItemTooltip Name="@Cloak.Name"
                     AccentColor="@UiText.RarityColor(Cloak.StuffRarity)"
                     Lines="@(new[] { Cloak.SimpleName })"
                     WhiteStats="@WhiteStats"
                     Combination="Cloak.StatCombination" />

        <div>
            <div class="nb-hint-muted" style="margin-bottom:6px">Редкость</div>
            <div class="nb-seg-group" role="radiogroup" aria-label="Редкость плаща">
                @foreach (var stuffRarity in Enum.GetValues(typeof(StuffRarity)).Cast<StuffRarity>())
                {
                    var currentRarity = stuffRarity;
                    var isActive = currentRarity == Cloak.StuffRarity;
                    <button type="button"
                            role="radio"
                            aria-checked="@(isActive ? "true" : "false")"
                            class="nb-seg @(isActive ? "nb-seg--active" : "")"
                            style="color:@UiText.RarityColor(currentRarity)"
                            @onclick="@(() => UpdateStuffRarity(currentRarity))">
                        @CommonNamesProvider.GetStuffRarityName(currentRarity)
                    </button>
                }
            </div>
        </div>

        <MudSelect
            T="StuffRuneOfImprovementLevel"
            Label="Выберите уровень руны улучшения"
            Value="@Cloak.RuneOfImprovementLevel"
            ToStringFunc="@RuneNamesProvider.GetStuffRuneName"
            ValueChanged="UpdateRuneLevel"
            Variant="Variant.Outlined"
            Margin="Margin.Dense">

            @foreach (var runeLevel in Enum.GetValues(typeof(StuffRuneOfImprovementLevel)).Cast<StuffRuneOfImprovementLevel>())
            {
                <MudSelectItem Value="@runeLevel"/>
            }
        </MudSelect>
        <div class="nb-hint-muted">Броня и магическая броня считаются сами по редкости и руне. Смените редкость или руну — диапазоны и значения выбранных характеристик пересчитаются.</div>
    </div>
</div>

@code {
    [Parameter]
    public Cloak Cloak { get; set; }

    [Parameter]
    public EventCallback<Cloak> CloakChanged { get; set; }

    // Общий множитель плаща: зелёный × редкость × руна улучшения — как в Cloak.
    private double StatScale => ScaleOf(Cloak);

    private static double ScaleOf(Cloak cloak) =>
        BaseStuffStatsMultiplier.GetCloakGreenStatMultiplier()
        * BaseStuffStatsMultiplier.GetStuffRarityMultiplier(cloak.StuffRarity)
        * StuffRuneOfImprovementMultiplier.RuneMultiplier(cloak.RuneOfImprovementLevel);

    private IEnumerable<Stat> WhiteStats =>
        new[] { Cloak.BaseArmorStat, Cloak.BaseMagicArmorStat }.Where(stat => stat.StatNumber > 0);

    private async Task UpdateStatCombination(StatCombination newStatCombination)
    {
        Cloak = Cloak.CreateFromInstance(newStatCombination);
        await CloakChanged.InvokeAsync(Cloak);
    }

    private Task UpdateRuneLevel(StuffRuneOfImprovementLevel runeLevel)
    {
        return ChangeMultiplierAsync(newRuneLevel: runeLevel);
    }

    private Task UpdateStuffRarity(StuffRarity stuffRarity)
    {
        return ChangeMultiplierAsync(newStuffRarity: stuffRarity);
    }

    // При смене редкости или руны уже выбранные характеристики пересчитываются под новый множитель.
    private async Task ChangeMultiplierAsync(
        StuffRuneOfImprovementLevel? newRuneLevel = null,
        StuffRarity? newStuffRarity = null)
    {
        var oldScale = StatScale;
        var changed = Cloak.CreateFromInstance(newRuneLevel: newRuneLevel, newStuffRarity: newStuffRarity);
        var rescaled = StatRangeProvider.Rescale(changed.StatCombination, oldScale, ScaleOf(changed));

        Cloak = ReferenceEquals(rescaled, changed.StatCombination) ? changed : changed.CreateFromInstance(rescaled);
        await CloakChanged.InvokeAsync(Cloak);
    }
}
