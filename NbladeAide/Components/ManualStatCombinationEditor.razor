@using Models.Multipliers
@using Models.Names
@using Models.Stats

@for (var i = 0; i < SlotCount; i++)
{
    var index = i;
    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudAutocomplete T="StatType?"
                             Label="@($"Характеристика {index + 1}")"
                             Value="@_slots[index].StatType"
                             SearchFunc="@SearchAvailableStats"
                             ValueChanged="@(newType => UpdateSlotType(index, newType))"
                             ToStringFunc="@(t => t.HasValue ? StatNamesProvider.GetStatName(t.Value) : string.Empty)"
                             MaxItems="null"
                             Clearable="true" />
        </MudItem>
        <MudItem xs="4">
            <MudNumericField T="int"
                             Label="Мин"
                             Value="@_slots[index].Min"
                             Variant="Variant.Outlined"
                             Disabled="@(!_slots[index].StatType.HasValue)"
                             ValueChanged="@(newMin => UpdateSlotMin(index, newMin))" />
        </MudItem>
        <MudItem xs="4">
            <MudNumericField T="int"
                             Label="Макс"
                             Value="@_slots[index].Max"
                             Variant="Variant.Outlined"
                             Disabled="@(!_slots[index].StatType.HasValue)"
                             ValueChanged="@(newMax => UpdateSlotMax(index, newMax))" />
        </MudItem>
        <MudItem xs="4">
            <MudNumericField T="int"
                             Label="Значение на вещи"
                             Value="@_slots[index].Value"
                             Min="@_slots[index].Min"
                             Max="@_slots[index].Max"
                             Variant="Variant.Outlined"
                             Disabled="@(!_slots[index].StatType.HasValue)"
                             ValueChanged="@(newValue => UpdateSlotValue(index, newValue))" />
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public StatCombination StatCombination { get; set; }

    [Parameter]
    public EventCallback<StatCombination> StatCombinationChanged { get; set; }

    [Parameter]
    public int SlotCount { get; set; } = 4;

    // Общий множитель вещи (зелёный × редкость × руна). Если больше 0, то при выборе
    // характеристики мин/макс/значение подставляются автоматически; их по-прежнему можно менять.
    [Parameter]
    public double ScaleMultiplier { get; set; }

    private (StatType? StatType, int Min, int Max, int Value)[] _slots = Array.Empty<(StatType?, int, int, int)>();
    private StatCombination? _lastSyncedCombination;

    protected override void OnParametersSet()
    {
        if (_slots.Length != SlotCount || !ReferenceEquals(StatCombination, _lastSyncedCombination))
        {
            _lastSyncedCombination = StatCombination;
            var stats = StatCombination.Stats;
            var custom = StatCombination as CustomStatCombination;
            var slots = new (StatType? StatType, int Min, int Max, int Value)[SlotCount];
            for (var i = 0; i < SlotCount; i++)
            {
                if (i < stats.Length)
                {
                    var min = custom?.GetMin(i) ?? stats[i].StatNumber;
                    var max = custom?.GetMax(i) ?? stats[i].StatNumber;
                    slots[i] = (stats[i].StatType, min, max, stats[i].StatNumber);
                }
                else
                {
                    slots[i] = (null, 0, 0, 0);
                }
            }
            _slots = slots;
        }
    }

    private Task<IEnumerable<StatType?>> SearchAvailableStats(string value)
    {
        // Игра допускает до 4 одинаковых характеристик на одной вещи — не исключаем
        // типы, уже выбранные в других полях.
        var options = Enum.GetValues<StatType>()
            .Where(t => t != StatType.CharacterSpeed)
            .Where(t => string.IsNullOrWhiteSpace(value)
                        || StatNamesProvider.GetStatName(t).Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(t => (StatType?)t);

        return Task.FromResult(options);
    }

    private async Task UpdateSlotType(int index, StatType? newType)
    {
        if (!newType.HasValue)
        {
            _slots[index] = (null, 0, 0, 0);
        }
        else if (ScaleMultiplier > 0)
        {
            var range = StatRangeProvider.GetRange(newType.Value, ScaleMultiplier);
            _slots[index] = (newType, range.Min, range.Max, range.Value);
        }
        else
        {
            var slot = _slots[index];
            _slots[index] = (newType, slot.Min, slot.Max, slot.Value);
        }

        await CommitAsync();
    }

    private async Task UpdateSlotMin(int index, int newMin)
    {
        var slot = _slots[index];
        var newMax = Math.Max(slot.Max, newMin);
        var newValue = Math.Clamp(slot.Value, newMin, newMax);
        _slots[index] = (slot.StatType, newMin, newMax, newValue);
        await CommitAsync();
    }

    private async Task UpdateSlotMax(int index, int newMax)
    {
        var slot = _slots[index];
        var newMin = Math.Min(slot.Min, newMax);
        var newValue = Math.Clamp(slot.Value, newMin, newMax);
        _slots[index] = (slot.StatType, newMin, newMax, newValue);
        await CommitAsync();
    }

    private async Task UpdateSlotValue(int index, int newValue)
    {
        var slot = _slots[index];
        var clamped = Math.Clamp(newValue, slot.Min, slot.Max);
        _slots[index] = (slot.StatType, slot.Min, slot.Max, clamped);
        await CommitAsync();
    }

    private async Task CommitAsync()
    {
        var stats = _slots
            .Where(s => s.StatType.HasValue)
            .Select(s => (s.StatType!.Value, s.Min, s.Max, s.Value))
            .ToArray();

        StatCombination newCombination = stats.Length == 0
            ? EmptyStatCombination.FourStats
            : new CustomStatCombination(StatCombinationType.FourStats, stats);

        _lastSyncedCombination = newCombination;
        await StatCombinationChanged.InvokeAsync(newCombination);
    }
}
