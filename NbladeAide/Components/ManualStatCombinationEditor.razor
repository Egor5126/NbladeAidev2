@using Models.Multipliers
@using Models.Names
@using Models.Stats

@for (var i = 0; i < SlotCount; i++)
{
    var index = i;
    var slot = _slots[index];
    var hasType = slot.StatType.HasValue;
    var hasRange = slot.Max > slot.Min;
    <div class="nb-slot">
        <div class="nb-slot-top">
            <div class="nb-slot-type">
                <MudAutocomplete T="StatType?"
                                 Label="Характеристика"
                                 Value="@slot.StatType"
                                 SearchFunc="@SearchAvailableStats"
                                 ValueChanged="@(newType => UpdateSlotType(index, newType))"
                                 ToStringFunc="@(t => t.HasValue ? UiText.StatName(t.Value) : string.Empty)"
                                 MaxItems="null"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Clearable="true" />
            </div>
            <label class="nb-slot-value @(hasType ? "" : "nb-slot-value--off")">
                <span class="nb-slot-caption">Значение</span>
                <span class="nb-slot-valuebox">
                    <span class="nb-slot-plus" aria-hidden="true">+</span>
                    <input type="number"
                           class="nb-num nb-num--value"
                           value="@slot.Value"
                           disabled="@(!hasType)"
                           @onchange="@(e => CommitSlotNumber(index, e, SlotField.Value))" />
                </span>
            </label>
        </div>
        <div class="nb-slot-range">
            <input type="number"
                   class="nb-num nb-num--bound"
                   aria-label="Минимум"
                   title="Минимум диапазона"
                   value="@slot.Min"
                   disabled="@(!hasType)"
                   @onchange="@(e => CommitSlotNumber(index, e, SlotField.Min))" />
            <input type="range"
                   class="nb-range"
                   aria-label="Значение на вещи"
                   min="@slot.Min"
                   max="@slot.Max"
                   value="@slot.Value"
                   disabled="@(!hasType || !hasRange)"
                   @oninput="@(e => PreviewSlotValue(index, e))"
                   @onchange="@(e => CommitSlotValue(index, e))" />
            <input type="number"
                   class="nb-num nb-num--bound nb-num--bound-max"
                   aria-label="Максимум"
                   title="Максимум диапазона"
                   value="@slot.Max"
                   disabled="@(!hasType)"
                   @onchange="@(e => CommitSlotNumber(index, e, SlotField.Max))" />
        </div>
    </div>
}

@code {
    [Parameter]
    public StatCombination StatCombination { get; set; }

    [Parameter]
    public EventCallback<StatCombination> StatCombinationChanged { get; set; }

    [Parameter]
    public int SlotCount { get; set; } = 4;

    // Общий множитель вещи (зелёный × редкость × руна). Если больше 0, то при выборе
    // характеристики мин/макс/значение подставляются автоматически; их по-прежнему можно менять.
    [Parameter]
    public double ScaleMultiplier { get; set; }

    private (StatType? StatType, int Min, int Max, int Value)[] _slots = Array.Empty<(StatType?, int, int, int)>();
    private StatCombination? _lastSyncedCombination;

    protected override void OnParametersSet()
    {
        if (_slots.Length != SlotCount || !ReferenceEquals(StatCombination, _lastSyncedCombination))
        {
            _lastSyncedCombination = StatCombination;
            var stats = StatCombination.Stats;
            var custom = StatCombination as CustomStatCombination;
            var slots = new (StatType? StatType, int Min, int Max, int Value)[SlotCount];
            for (var i = 0; i < SlotCount; i++)
            {
                if (i < stats.Length)
                {
                    var min = custom?.GetMin(i) ?? stats[i].StatNumber;
                    var max = custom?.GetMax(i) ?? stats[i].StatNumber;
                    slots[i] = (stats[i].StatType, min, max, stats[i].StatNumber);
                }
                else
                {
                    slots[i] = (null, 0, 0, 0);
                }
            }
            _slots = slots;
        }
    }

    private Task<IEnumerable<StatType?>> SearchAvailableStats(string value)
    {
        // Игра допускает до 4 одинаковых характеристик на одной вещи — не исключаем
        // типы, уже выбранные в других полях.
        var allTypes = Enum.GetValues<StatType>()
            .Where(t => t != StatType.CharacterSpeed)
            .ToArray();

        // Когда характеристика уже выбрана, в поле стоит её название, и при повторном открытии списка
        // оно приходит сюда как строка поиска. Если оно целиком совпадает с названием стата —
        // игрок не печатал поиск, а просто открыл список, поэтому показываем все варианты.
        var isExactName = allTypes.Any(t =>
            string.Equals(StatNamesProvider.GetStatName(t), value, StringComparison.OrdinalIgnoreCase));

        var options = allTypes
            .Where(t => string.IsNullOrWhiteSpace(value)
                        || isExactName
                        || StatNamesProvider.GetStatName(t).Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(t => (StatType?)t);

        return Task.FromResult(options);
    }

    private async Task UpdateSlotType(int index, StatType? newType)
    {
        if (!newType.HasValue)
        {
            _slots[index] = (null, 0, 0, 0);
        }
        else if (ScaleMultiplier > 0)
        {
            var range = StatRangeProvider.GetRange(newType.Value, ScaleMultiplier);
            _slots[index] = (newType, range.Min, range.Max, range.Value);
        }
        else
        {
            var slot = _slots[index];
            _slots[index] = (newType, slot.Min, slot.Max, slot.Value);
        }

        await CommitAsync();
    }

    private enum SlotField { Value, Min, Max }

    // Обычные числовые поля вместо MudNumericField: выглядят как цифры в макете, а не как отдельные формы.
    private async Task CommitSlotNumber(int index, ChangeEventArgs e, SlotField field)
    {
        if (!int.TryParse(e.Value?.ToString(), out var number))
            return;

        number = Math.Max(0, number);
        switch (field)
        {
            case SlotField.Value:
                await UpdateSlotValue(index, number);
                break;
            case SlotField.Min:
                await UpdateSlotMin(index, number);
                break;
            default:
                await UpdateSlotMax(index, number);
                break;
        }
    }

    private async Task UpdateSlotMin(int index, int newMin)
    {
        var slot = _slots[index];
        var newMax = Math.Max(slot.Max, newMin);
        var newValue = Math.Clamp(slot.Value, newMin, newMax);
        _slots[index] = (slot.StatType, newMin, newMax, newValue);
        await CommitAsync();
    }

    private async Task UpdateSlotMax(int index, int newMax)
    {
        var slot = _slots[index];
        var newMin = Math.Min(slot.Min, newMax);
        var newValue = Math.Clamp(slot.Value, newMin, newMax);
        _slots[index] = (slot.StatType, newMin, newMax, newValue);
        await CommitAsync();
    }

    private async Task UpdateSlotValue(int index, int newValue)
    {
        var slot = _slots[index];

        // Пока диапазон не задан (мин = макс), диапазон просто следует за введённым значением.
        if (slot.Max <= slot.Min)
        {
            _slots[index] = (slot.StatType, newValue, newValue, newValue);
        }
        else
        {
            var clamped = Math.Clamp(newValue, slot.Min, slot.Max);
            _slots[index] = (slot.StatType, slot.Min, slot.Max, clamped);
        }

        await CommitAsync();
    }

    // Пока ползунок тянут — только обновляем число на экране, без пересчёта вещи.
    private void PreviewSlotValue(int index, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            return;

        var slot = _slots[index];
        if (slot.Max <= slot.Min)
            return;

        _slots[index] = (slot.StatType, slot.Min, slot.Max, Math.Clamp(value, slot.Min, slot.Max));
    }

    // Когда ползунок отпустили — сохраняем значение в вещь.
    private async Task CommitSlotValue(int index, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
            return;

        await UpdateSlotValue(index, value);
    }

    private async Task CommitAsync()
    {
        var stats = _slots
            .Where(s => s.StatType.HasValue)
            .Select(s => (s.StatType!.Value, s.Min, s.Max, s.Value))
            .ToArray();

        StatCombination newCombination = stats.Length == 0
            ? EmptyStatCombination.FourStats
            : new CustomStatCombination(StatCombinationType.FourStats, stats);

        _lastSyncedCombination = newCombination;
        await StatCombinationChanged.InvokeAsync(newCombination);
    }
}
