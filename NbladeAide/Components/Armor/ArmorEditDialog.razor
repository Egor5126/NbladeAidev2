@using Models.BaseModels.Armors

@typeparam TArmor where TArmor : ArmorBase

<MudDialog>
    <TitleContent>
        <div class="nb-eyebrow">@_draft.SimpleName</div>
        <div class="nb-dialog-name" style="color:@UiText.Violet">@_draft.Name</div>
    </TitleContent>
    <DialogContent>
        <ArmorComponent @bind-Armor="_draft" TArmor="TArmor"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public TArmor Armor { get; set; }

    // Правим копию вещи: оригинал в персонаже подменяется только по кнопке «Сохранить»,
    // поэтому «Отмена» (и закрытие крестиком/Esc) ничего не меняет.
    private TArmor _draft = null!;

    protected override void OnInitialized()
    {
        _draft = (TArmor)Armor.CreateFromInstance();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(_draft));
    }

    private void Cancel() => MudDialog.Cancel();
}
