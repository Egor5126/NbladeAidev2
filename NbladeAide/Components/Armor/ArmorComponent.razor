@using Models.Stats
@using Models.BaseModels
@using Models.Multipliers
@using Models.Providers
@using Models.Names

@typeparam TArmor where TArmor : ArmorBase

<ArmorCompressedInfo Armor="Armor" />

<br />
<MudText Typo="Typo.h6" Style="@($"font-size: medium;")">Характеристики</MudText>

@* Выбор готовой комбинации из списка временно скрыт — характеристики теперь выбираются вручную ниже *@

<ManualStatCombinationEditor StatCombination="Armor.StatCombination"
                             StatCombinationChanged="UpdateStatCombination"
                             ScaleMultiplier="@StatScale" />

<MudSelect
    T="StuffRuneOfImprovementLevel"
    Label="Выберите уровень руны улучшения"
    Value="@Armor.RuneOfImprovementLevel"
    ToStringFunc="@RuneNamesProvider.GetStuffRuneName"
    ValueChanged="UpdateRuneLevel">

    @foreach (var classType in Enum.GetValues(typeof(StuffRuneOfImprovementLevel)).Cast<StuffRuneOfImprovementLevel>())
    {
        <MudSelectItem Value="@classType"/>
    }
</MudSelect>

<br />
<GemComponent @bind-Gem="Armor.Gem1"/>
<br />
<ConcentrationGemComponent @bind-ConcentrationGem="Armor.Gem2"/>

@code {
    [Parameter]
    public TArmor Armor { get; set; }

    [Parameter]
    public EventCallback<TArmor> ArmorChanged { get; set; }

    // Общий множитель брони: множитель типа брони × руна улучшения — как в ArmorBase.
    private double StatScale =>
        BaseStuffStatsMultiplier.GetArmorGreenStatMultiplier(Armor.ArmorType)
        * StuffRuneOfImprovementMultiplier.RuneMultiplier(Armor.RuneOfImprovementLevel);

    private async Task UpdateStatCombination(StatCombination newStatCombination)
    {
        Armor.UpdateStatCombination(newStatCombination);
        await ArmorChanged.InvokeAsync(Armor);
    }

    private async Task UpdateRuneLevel(StuffRuneOfImprovementLevel runeLevel)
    {
        Armor = (TArmor)Armor.CreateFromInstance(newRuneLevel: runeLevel);
        await ArmorChanged.InvokeAsync(Armor);
    }
}