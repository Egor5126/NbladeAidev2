@using Models.BaseModels.Armors

@inject IDialogService DialogService

@typeparam TArmor where TArmor : ArmorBase

<ArmorCompressedInfo Armor="Armor" />

<br />

<MudButton @onclick="@OpenDialogAsync" Variant="Variant.Outlined" Color="Color.Primary">
    Редактировать
</MudButton>

@code {
    [Parameter]
    public TArmor Armor { get; set; }

    [Parameter]
    public EventCallback<TArmor> ArmorChanged { get; set; }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true};
        var parameters = new DialogParameters<ArmorEditDialog<TArmor>> { { x => x.Armor, Armor } };

        var dialog = await DialogService.ShowAsync<ArmorEditDialog<TArmor>>("Simple Dialog", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var p = (TArmor)result.Data;
            Armor = p;
            await ArmorChanged.InvokeAsync(Armor);
        }
    }
}