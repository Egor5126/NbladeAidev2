@using Models.BaseModels
@using Models.Names
@using Models.Stats

<div class="nb-gem">
<h3 class="nb-gem-title">Камень силы</h3>

<MudSelect
    T="PowerStoneLevel"
    Label="Уровень камня"
    Value="@Gem.GemLevel"
    ToStringFunc="@GemNamesProvider.GetGemLevelName"
    ValueChanged="UpdateGemLevel"
    Variant="Variant.Outlined"
    Margin="Margin.Dense">

    @foreach (var classType in Enum.GetValues(typeof(PowerStoneLevel)).Cast<PowerStoneLevel>())
    {
        <MudSelectItem Value="@classType"/>
    }
</MudSelect>

<MudAutocomplete
    T="Stat"
    Label="Характеристика камня"
    Value="@Gem.Stat"
    SearchFunc="@SearchPotentialStats"
    ValueChanged="UpdateStat"
    MaxItems="null"
    Variant="Variant.Outlined"
    Margin="Margin.Dense"
    Clearable="true"
    Disabled="@(Gem.GemLevel == PowerStoneLevel.None)"/>
</div>

@code {
    [Parameter]
    public Gem Gem { get; set; }

    [Parameter]
    public EventCallback<Gem> GemChanged { get; set; }

    private Task<IEnumerable<Stat>> SearchPotentialStats(string value)
    {
        var states = Gem.PotentialStats;

        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<Stat>>(states);
        return Task.FromResult(
            states.Where(x => x.ToString().Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private async Task UpdateStat(Stat newStat)
    {
        Gem = Gem.CreateFromInstance(newStat);
        await GemChanged.InvokeAsync(Gem);
    }

    private async Task UpdateGemLevel(PowerStoneLevel gemLevel)
    {
        Gem = Gem.CreateFromInstance(newGemLevel: gemLevel);
        await GemChanged.InvokeAsync(Gem);
    }
}