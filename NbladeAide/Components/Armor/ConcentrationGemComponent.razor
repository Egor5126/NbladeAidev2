@using Models.BaseModels
@using Models.Names
@using Models.Stats

<div class="nb-gem">
<h3 class="nb-gem-title">Камень концентрации</h3>

<MudSelect
    T="ConcentrationStoneLevel"
    Label="Уровень камня"
    Value="@ConcentrationGem.GemLevel"
    ToStringFunc="@GemNamesProvider.GetConcentrationStoneLevelName"
    ValueChanged="UpdateGemLevel"
    Variant="Variant.Outlined"
    Margin="Margin.Dense">

    @foreach (var level in Enum.GetValues(typeof(ConcentrationStoneLevel)).Cast<ConcentrationStoneLevel>())
    {
        <MudSelectItem Value="@level"/>
    }
</MudSelect>

<MudAutocomplete
    T="StatType?"
    Label="Характеристика камня"
    Value="@ConcentrationGem.StatType"
    SearchFunc="@SearchPotentialStats"
    ValueChanged="UpdateGemStat"
    ToStringFunc="@(statType => statType.HasValue ? StatNamesProvider.GetStatName(statType.Value) : string.Empty)"
    MaxItems="null"
    Variant="Variant.Outlined"
    Margin="Margin.Dense"
    Clearable="true"
    Disabled="@(ConcentrationGem.GemLevel == ConcentrationStoneLevel.None)"/>
</div>

@code {
    [Parameter]
    public ConcentrationGem ConcentrationGem { get; set; }

    [Parameter]
    public EventCallback<ConcentrationGem> ConcentrationGemChanged { get; set; }

    private async Task UpdateGemLevel(ConcentrationStoneLevel gemLevel)
    {
        ConcentrationGem = ConcentrationGem.CreateFromInstance(newGemLevel: gemLevel);
        await ConcentrationGemChanged.InvokeAsync(ConcentrationGem);
    }

    private async Task UpdateGemStat(StatType? statType)
    {
        if (!statType.HasValue)
            return;

        ConcentrationGem = ConcentrationGem.CreateFromInstance(statType: statType.Value);
        await ConcentrationGemChanged.InvokeAsync(ConcentrationGem);
    }

    private Task<IEnumerable<StatType?>> SearchPotentialStats(string value)
    {
        var states = Enum.GetValues<StatType>()
            .Where(statType => statType != StatType.CharacterSpeed)
            .Select(statType => (StatType?)statType);

        return Task.FromResult(string.IsNullOrEmpty(value)
            ? states
            : states
                .Where(x => StatNamesProvider.GetStatName(x!.Value)
                .Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }
}
