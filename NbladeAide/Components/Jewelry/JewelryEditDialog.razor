@using Models.BaseModels.Jewelry

@typeparam TJewelry where TJewelry : JewelryBase

<MudDialog>
    <TitleContent>
        Изменение характеристик
    </TitleContent>
    <DialogContent>
        <JewelryComponent @bind-Jewelry="Jewelry" TJewelry="TJewelry"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public TJewelry Jewelry { get; set; }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Jewelry));
    }

    private void Cancel() => MudDialog.Cancel();
}