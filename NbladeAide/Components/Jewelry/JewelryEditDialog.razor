@using Models.BaseModels.Jewelry

@typeparam TJewelry where TJewelry : JewelryBase

<MudDialog>
    <TitleContent>
        <DialogHeader @ref="_header" Source="@(() => (Jewelry.SimpleName, Jewelry.Name, UiText.RarityColor(Jewelry.StuffRarity)))" />
    </TitleContent>
    <DialogContent>
        <JewelryComponent Jewelry="Jewelry" JewelryChanged="OnJewelryChanged" TJewelry="TJewelry"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public TJewelry Jewelry { get; set; }

    private DialogHeader? _header;

    private void OnJewelryChanged(TJewelry jewelry)
    {
        Jewelry = jewelry;
        _header?.Refresh();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Jewelry));
    }

    private void Cancel() => MudDialog.Cancel();
}