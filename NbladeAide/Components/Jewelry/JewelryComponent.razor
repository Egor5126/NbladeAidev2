@using Models.Stats
@using Models.BaseModels
@using Models.Names
@using Models.BaseModels.Jewelry
@using Models.Providers

@typeparam TJewelry where TJewelry : JewelryBase

<JewelryCompressedInfo Jewelry="Jewelry" />

<br />
<MudText Typo="Typo.h6" Style="@($"font-size: medium;")">Характеристики</MudText>

<MudForm>
    <MudRadioGroup T="StatCombinationType" SelectedOption="@Jewelry.StatCombination.StatCombinationType" SelectedOptionChanged="ChangeStatCombinationType">
        <MudRadio Value="@StatCombinationType.ThreeStats" Color="Color.Primary">3 хар-ки</MudRadio>
        <MudRadio Value="@StatCombinationType.FourStats" Color="Color.Secondary">4 хар-ки</MudRadio>
    </MudRadioGroup>
</MudForm>

<MudAutocomplete
    T="StatCombination"
    Label="Выберите характеристики предмета"
    Value="@Jewelry.StatCombination"
    SearchFunc="@SearchPotentialStatCombinations"
    ValueChanged="UpdateStatCombination"
    MaxItems="null"
    Clearable="true" />

<MudSelect
    T="JewelryRuneOfImprovementLevel"
    Label="Выберите уровень руны улучшения"
    Value="@Jewelry.JewelryRuneOfImprovementLevel"
    ToStringFunc="@RuneNamesProvider.GetJewelryRuneName"
    ValueChanged="UpdateRuneLevel">

    @foreach (var runeLevel in Enum.GetValues(typeof(JewelryRuneOfImprovementLevel)).Cast<JewelryRuneOfImprovementLevel>())
    {
        <MudSelectItem Value="@runeLevel"/>
    }
</MudSelect>

<MudSelect
    T="StuffRarity"
    Label="Выберите редкость бижутерии"
    Value="@Jewelry.StuffRarity"
    ToStringFunc="@CommonNamesProvider.GetStuffRarityName"
    ValueChanged="UpdateStuffRarity">

    @foreach (var stuffRarity in Enum.GetValues(typeof(StuffRarity)).Cast<StuffRarity>())
    {
        @if (stuffRarity != StuffRarity.Red)
        {
            <MudSelectItem Value="@stuffRarity"/>
        }
    }
</MudSelect>

@code {
    [Parameter]
    public TJewelry Jewelry { get; set; }

    [Parameter]
    public EventCallback<TJewelry> JewelryChanged { get; set; }

    private Task<IEnumerable<StatCombination>> SearchPotentialStatCombinations(string value)
    {
        var states = Jewelry.PotentialStatCombinations;

        return Task.FromResult(FilterService.FilterStatCombinations(states, value));
    }

    private async Task UpdateStatCombination(StatCombination newStatCombination)
    {
        Jewelry = (TJewelry)Jewelry.CreateFromInstance(newStatCombination);
        await JewelryChanged.InvokeAsync(Jewelry);
    }

    private async Task UpdateRuneLevel(JewelryRuneOfImprovementLevel runeLevel)
    {
        Jewelry = (TJewelry)Jewelry.CreateFromInstance(newRuneLevel: runeLevel);
        await JewelryChanged.InvokeAsync(Jewelry);
    }

    private async Task ChangeStatCombinationType(StatCombinationType statCombinationType)
    {
        Jewelry = (TJewelry)Jewelry.CreateFromInstance(StatCombination.GetRandomStatCombination(statCombinationType));
        await JewelryChanged.InvokeAsync(Jewelry);
    }

    private async Task UpdateStuffRarity(StuffRarity stuffRarity)
    {
        Jewelry = (TJewelry)Jewelry.CreateFromInstance(newStuffRarity: stuffRarity);
        await JewelryChanged.InvokeAsync(Jewelry);
    }
}