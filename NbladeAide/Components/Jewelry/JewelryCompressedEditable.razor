@using Models.BaseModels.Jewelry

@inject IDialogService DialogService

@typeparam TJewelry where TJewelry : JewelryBase

<ItemCard Slot="@Jewelry.SimpleName"
          Name="@Jewelry.Name"
          AccentColor="@UiText.RarityColor(Jewelry.StuffRarity)"
          Combination="Jewelry.StatCombination"
          OnClick="OpenDialogAsync" />

@code {
    [Parameter]
    public TJewelry Jewelry { get; set; }

    [Parameter]
    public EventCallback<TJewelry> JewelryChanged { get; set; }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true};
        var parameters = new DialogParameters<JewelryEditDialog<TJewelry>> { { x => x.Jewelry, Jewelry } };

        var dialog = await DialogService.ShowAsync<JewelryEditDialog<TJewelry>>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var p = (TJewelry)result.Data;
            Jewelry = p;
            await JewelryChanged.InvokeAsync(Jewelry);
        }
    }
}
