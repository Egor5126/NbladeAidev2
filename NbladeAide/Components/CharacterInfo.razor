@using Models
@using Models.BaseModels
@using Models.BaseModels.Amplification
@using Models.BaseModels.Jewelry
@using Models.BaseModels.Weapon
@using Models.Names
@using Models.Sharing
@using Models.Stats

@inject CharacterManager CharacterManager
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="nb-toolbar">
    @foreach (var classType in Enum.GetValues(typeof(CharacterClass)).Cast<CharacterClass>())
    {
        var currentClass = classType;
        <button type="button"
                class="nb-chip @(currentClass == Character.CharacterClass ? "nb-chip--active" : "")"
                aria-pressed="@(currentClass == Character.CharacterClass ? "true" : "false")"
                @onclick="@(() => ChangeCharacterClass(currentClass))">
            @ClassNamesProvider.GetClassName(currentClass)
        </button>
    }
    <div class="nb-toolbar-spacer"></div>
    <MudButton @onclick="ShareBuildAsync" Variant="Variant.Filled" Color="Color.Primary">
        Поделиться билдом
    </MudButton>
</div>

<div class="nb-layout">

    <div class="nb-main">

        <section class="nb-panel">
            <h2 class="nb-section-title">Экипировка</h2>

            <div class="nb-cols">
                <div class="nb-col">
                    <ArmorCompressedEditable @bind-Armor="Character.Helmet" TArmor="Helmet" />
                    <ArmorCompressedEditable @bind-Armor="Character.ShoulderPad" TArmor="ShoulderPad" />
                    <ArmorCompressedEditable @bind-Armor="Character.Cuirass" TArmor="Cuirass" />
                    <ArmorCompressedEditable @bind-Armor="Character.Highway" TArmor="Highway" />
                </div>
                <div class="nb-col">
                    <ArmorCompressedEditable @bind-Armor="Character.Gloves" TArmor="Gloves" />
                    <ArmorCompressedEditable @bind-Armor="Character.Bracers" TArmor="Bracers" />
                    <ArmorCompressedEditable @bind-Armor="Character.Belt" TArmor="Belt" />
                    <ArmorCompressedEditable @bind-Armor="Character.Shoes" TArmor="Shoes" />
                </div>
            </div>

            <h3 class="nb-subtitle">Бижутерия и плащ</h3>
            <div class="nb-grid">
                <JewelryCompressedEditable @bind-Jewelry="Character.Amulet1" TJewelry="Amulet" />
                <JewelryCompressedEditable @bind-Jewelry="Character.Amulet2" TJewelry="Amulet" />
                <JewelryCompressedEditable @bind-Jewelry="Character.Necklace" TJewelry="Necklace" />
                <JewelryCompressedEditable @bind-Jewelry="Character.Ring1" TJewelry="Ring" />
                <JewelryCompressedEditable @bind-Jewelry="Character.Ring2" TJewelry="Ring" />
                <CloakCompressedEditable @bind-Cloak="Character.Cloak" />
            </div>
        </section>

        <section class="nb-panel">
            <h2 class="nb-section-title">Оружие</h2>
            <div class="nb-grid nb-grid--wide">
                <div>
                    <MudSelect
                        T="WeaponType"
                        Label="Тип основного оружия"
                        Value="@Character.MainWeapon.WeaponType"
                        ToStringFunc="@WeaponNamesProvider.GetWeaponNameByType"
                        ValueChanged="ChangeMainWeapon"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"
                        Class="mb-3">

                        @foreach (var weaponType in Character.MainWeapon.GetAvailableWeaponTypes())
                        {
                            <MudSelectItem Value="@weaponType"/>
                        }
                    </MudSelect>
                    <WeaponCompressedEditable @bind-Weapon="Character.MainWeapon"/>
                </div>
                @if (Character.SecondWeapon != null)
                {
                    <div>
                        <MudSelect
                            T="WeaponType"
                            Label="Тип доп. оружия"
                            Value="@Character.SecondWeapon.WeaponType"
                            ToStringFunc="@WeaponNamesProvider.GetWeaponNameByType"
                            ValueChanged="@(newType => Character.SecondWeapon = Character.SecondWeapon.CreateFromWeaponType(newType))"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            Class="mb-3">

                            @foreach (var weaponType in Character.SecondWeapon.GetAvailableWeaponTypes())
                            {
                                <MudSelectItem Value="@weaponType"/>
                            }
                        </MudSelect>
                        <WeaponCompressedEditable @bind-Weapon="Character.SecondWeapon"/>
                    </div>
                }
            </div>
        </section>

        <section class="nb-panel">
            <h2 class="nb-section-title">Усиления</h2>
            <div class="nb-fields">
                <div class="nb-field">
                    <MudSelect
                        T="Elixir"
                        Label="Атакующий эликсир"
                        @bind-Value="@Character.AttackElixir"
                        ToStringFunc="@(e => e.Name)"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"
                        Clearable>

                        @foreach (var elixir in ElixirProvider.AttackElixirs)
                        {
                            <MudSelectItem Value="@elixir"/>
                        }
                    </MudSelect>
                </div>
                <div class="nb-field">
                    <MudSelect
                        T="Elixir"
                        Label="Защитный эликсир"
                        @bind-Value="@Character.DefenseElixir"
                        ToStringFunc="@(e => e.Name)"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"
                        Clearable>

                        @foreach (var elixir in ElixirProvider.DefenceElixirs)
                        {
                            <MudSelectItem Value="@elixir"/>
                        }
                    </MudSelect>
                </div>
            </div>
            @if (Character.CharacterClass == CharacterClass.Warrior)
            {
                <div class="nb-field" style="margin-top:12px">
                    <MudSelect
                        T="WarriorAura"
                        Label="Аура воина"
                        @bind-Value="@Character.WarriorAura"
                        ToStringFunc="@WarriorAuraProvider.GetName"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"
                        HelperText="@WarriorAuraProvider.GetDescription(Character.WarriorAura)">

                        @foreach (var aura in Enum.GetValues<WarriorAura>())
                        {
                            <MudSelectItem Value="@aura"/>
                        }
                    </MudSelect>
                </div>
            }
            <div class="nb-amps">
                @foreach (var availableAmplification in Character.AvailableAmplifications)
                {
                    <MudCheckBox @bind-Value="@availableAmplification.Used" Label="@availableAmplification.Name" Color="Color.Primary" Dense="true"></MudCheckBox>
                    <MudText Typo="Typo.caption" Class="ml-8" Style="color: var(--nb-muted)">@availableAmplification.Description</MudText>
                }
            </div>
        </section>

    </div>

    <aside class="nb-aside" aria-label="Итоговые характеристики">

        @{
            var breakdown = Character.CalculateBreakdown();
        }

        <section class="nb-panel">
            <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px">
                <h2 class="nb-panel-title">Итоговые статы</h2>
                <span class="nb-panel-sub">@ClassNamesProvider.GetClassName(Character.CharacterClass)</span>
            </div>

            <div class="nb-legend">
                <span class="nb-legend-item"><span class="nb-swatch nb-seg-base"></span>Класс</span>
                <span class="nb-legend-item"><span class="nb-swatch nb-seg-gear"></span>Вещи</span>
                <span class="nb-legend-item"><span class="nb-swatch nb-seg-gems"></span>Камни</span>
                <span class="nb-legend-item"><span class="nb-swatch nb-seg-boost"></span>Эликсиры и усиления</span>
                @if (Character.CharacterClass == CharacterClass.Warrior && Character.WarriorAura != WarriorAura.None)
                {
                    <span class="nb-legend-item"><span class="nb-swatch nb-seg-aura"></span>Аура</span>
                }
            </div>

            @foreach (var group in StatGroups)
            {
                <div class="nb-group-title">@group.Title</div>
                @foreach (var statType in group.Types)
                {
                    var part = breakdown[statType];
                    <div class="nb-stat">
                        <div class="nb-stat-line">
                            <span>@UiText.StatName(statType)</span>
                            <span class="nb-total-value">@UiText.FormatNumber(part.Total)</span>
                        </div>
                        @if (part.Total > 0)
                        {
                            <div class="nb-bar" role="img"
                                 aria-label="@($"Класс {UiText.FormatNumber(part.Base)}, вещи {UiText.FormatNumber(part.Gear)}, камни {UiText.FormatNumber(part.Gems)}, эликсиры и усиления {UiText.FormatNumber(part.Boost)}, аура {UiText.FormatNumber(part.Aura)}")">
                                <div class="nb-seg-base" style="width:@Share(part.Base, part.Total)" title="@($"Класс: {UiText.FormatNumber(part.Base)}")"></div>
                                <div class="nb-seg-gear" style="width:@Share(part.Gear, part.Total)" title="@($"Вещи: {UiText.FormatNumber(part.Gear)}")"></div>
                                <div class="nb-seg-gems" style="width:@Share(part.Gems, part.Total)" title="@($"Камни: {UiText.FormatNumber(part.Gems)}")"></div>
                                <div class="nb-seg-boost" style="width:@Share(part.Boost, part.Total)" title="@($"Эликсиры и усиления: {UiText.FormatNumber(part.Boost)}")"></div>
                                <div class="nb-seg-aura" style="width:@Share(part.Aura, part.Total)" title="@($"Аура: {UiText.FormatNumber(part.Aura)}")"></div>
                            </div>
                        }
                    </div>
                }
            }
        </section>

    </aside>
</div>

@code {

    // Группы итоговых характеристик в том порядке, в каком они показываются справа.
    private static readonly (string Title, StatType[] Types)[] StatGroups =
    {
        ("Атака", new[]
        {
            StatType.AttackPower,
            StatType.Accuracy,
            StatType.CriticalChance,
            StatType.CriticalDamage,
            StatType.AttackSpeed,
        }),
        ("Защита", new[]
        {
            StatType.Armor,
            StatType.MagicArmor,
            StatType.MagicalResistance,
            StatType.CriticalDamageResistance,
            StatType.Evasion,
            StatType.Block,
            StatType.Parry,
        }),
        ("Жизнь и энергия", new[]
        {
            StatType.Health,
            StatType.HealthRestoration,
            StatType.Energy,
            StatType.EnergyRestoration,
        }),
        ("Прочее", new[]
        {
            StatType.CharacterSpeed,
        }),
    };

    // Доля части в итоге — ширина сегмента полоски под статом.
    private static string Share(int part, int total)
    {
        if (total <= 0 || part <= 0)
            return "0%";

        return (part * 100.0 / total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private Character Character { get; set; }

    protected override Task OnInitializedAsync()
    {
        var buildCode = GetQueryParam("b");
        // Заранее объявлены: из-за && компилятор не считает out-переменные присвоенными в ветке else.
        Character? sharedCharacter = null;
        string? decodeError = null;
        if (!string.IsNullOrEmpty(buildCode) && BuildCode.TryDecode(buildCode, out sharedCharacter, out decodeError) && sharedCharacter != null)
        {
            Character = sharedCharacter;
            CharacterManager.Character = sharedCharacter;
            Snackbar.Add("Билд загружен по ссылке", Severity.Info);
        }
        else
        {
            if (!string.IsNullOrEmpty(buildCode))
            {
                // Причину пишем в консоль браузера — так проще разобраться, чем со «сломанной ссылкой».
                Console.WriteLine($"Не удалось прочитать билд по ссылке: {decodeError}");
                Snackbar.Add("Не удалось прочитать билд по этой ссылке — открыт билд по умолчанию", Severity.Warning);
            }
            Character = CharacterManager.Character;
        }

        return Task.CompletedTask;
    }

    private string? GetQueryParam(string name)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query;
        if (string.IsNullOrEmpty(query))
            return null;

        var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var pair in pairs)
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]) == name)
                return Uri.UnescapeDataString(kv[1]);
        }

        return null;
    }

    private async Task ShareBuildAsync()
    {
        var code = BuildCode.Encode(Character);
        var url = Navigation.ToAbsoluteUri($"Calculator?b={Uri.EscapeDataString(code)}").ToString();

        var parameters = new DialogParameters<ShareBuildDialog> { { x => x.Url, url } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<ShareBuildDialog>("Поделиться билдом", parameters, options);
    }

    private void ChangeCharacterClass(CharacterClass newClass)
    {
        Character = Character.CreateFromCharacterClass(newClass);
    }

    private void ChangeMainWeapon(WeaponType newWeaponType)
    {
        Character.MainWeapon = Character.MainWeapon.CreateFromWeaponType(newWeaponType);
        if (Character.MainWeapon.WeaponHandedClass == WeaponHandedClass.TwoHandedWeapon)
            Character.SecondWeapon = null;
        if (Character.MainWeapon.WeaponHandedClass == WeaponHandedClass.OneHandedWeapon && Character.SecondWeapon == null)
            Character.SecondWeapon = Character.GetDefaultWeapons(Character.CharacterClass).secondWeapon;
    }
}
