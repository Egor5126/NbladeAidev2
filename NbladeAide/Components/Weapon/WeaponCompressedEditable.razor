@using Models.BaseModels.Weapon

@inject IDialogService DialogService

<WeaponCompressedInfo Weapon="Weapon" />

<br />

<MudButton @onclick="@OpenDialogAsync" Variant="Variant.Outlined" Color="Color.Primary">
    Редактировать
</MudButton>

@code {
    [Parameter]
    public WeaponBase Weapon { get; set; }

    [Parameter]
    public EventCallback<WeaponBase> WeaponChanged { get; set; }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true};
        var parameters = new DialogParameters<WeaponEditDialog> { { x => x.Weapon, Weapon } };

        var dialog = await DialogService.ShowAsync<WeaponEditDialog>("Simple Dialog", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var p = (WeaponBase)result.Data;
            Weapon = p;
            await WeaponChanged.InvokeAsync(Weapon);
        }
    }
}