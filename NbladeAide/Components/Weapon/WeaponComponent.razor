@using Models.Stats
@using Models.BaseModels
@using Models.Multipliers
@using Models.Names
@using Models.BaseModels.Weapon
@using Models.Providers

<WeaponCompressedInfo Weapon="Weapon" />

<br />
<MudText Typo="Typo.h6" Style="@($"font-size: medium;")">Характеристики</MudText>

@* Выбор готовой комбинации из списка временно скрыт — характеристики теперь выбираются вручную ниже *@

<ManualStatCombinationEditor StatCombination="Weapon.StatCombination"
                             StatCombinationChanged="UpdateStatCombination"
                             ScaleMultiplier="@StatScale" />

<MudSelect
    T="StuffRuneOfImprovementLevel"
    Label="Выберите уровень руны улучшения"
    Value="@Weapon.RuneOfImprovementLevel"
    ToStringFunc="@RuneNamesProvider.GetStuffRuneName"
    ValueChanged="UpdateRuneLevel">

    @foreach (var classType in Enum.GetValues(typeof(StuffRuneOfImprovementLevel)).Cast<StuffRuneOfImprovementLevel>())
    {
        <MudSelectItem Value="@classType"/>
    }
</MudSelect>

@for (var i = 0; i < Weapon.WeaponGems.Count; ++i)
{
    // ReSharper disable once InlineTemporaryVariable - избежание замыкания
    var currentIndex = i;
    <br />
    <WeaponGemComponent @bind-WeaponGem="Weapon.WeaponGems[currentIndex]" WeaponGemNumber="currentIndex + 1" />
}

@code {
    [Parameter]
    public WeaponBase Weapon { get; set; }

    [Parameter]
    public EventCallback<WeaponBase> WeaponChanged { get; set; }

    // Общий множитель оружия: одно-/двуручное × руна улучшения — как в WeaponBase.
    private double StatScale =>
        BaseStuffStatsMultiplier.GetWeaponGreenStatMultiplier(Weapon.WeaponHandedClass)
        * StuffRuneOfImprovementMultiplier.RuneMultiplier(Weapon.RuneOfImprovementLevel);

    private async Task UpdateStatCombination(StatCombination newStatCombination)
    {
        Weapon = Weapon.CreateFromInstance(newStatCombination);
        await WeaponChanged.InvokeAsync(Weapon);
    }

    private async Task UpdateRuneLevel(StuffRuneOfImprovementLevel runeLevel)
    {
        Weapon = Weapon.CreateFromInstance(newRuneLevel: runeLevel);
        await WeaponChanged.InvokeAsync(Weapon);
    }
}