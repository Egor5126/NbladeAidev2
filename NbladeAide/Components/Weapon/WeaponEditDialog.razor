@using Models.BaseModels.Weapon

<MudDialog>
    <TitleContent>
        <DialogHeader @ref="_header" Source="@(() => (_draft.SimpleName, _draft.Name, UiText.Violet))" />
    </TitleContent>
    <DialogContent>
        <WeaponComponent Weapon="_draft" WeaponChanged="OnDraftChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public WeaponBase Weapon { get; set; }

    // Правим копию вещи: оригинал в персонаже подменяется только по кнопке «Сохранить».
    private WeaponBase _draft = null!;
    private DialogHeader? _header;

    protected override void OnInitialized()
    {
        _draft = Weapon.CreateFromInstance();
    }

    private void OnDraftChanged(WeaponBase draft)
    {
        _draft = draft;
        _header?.Refresh();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(_draft));
    }

    private void Cancel() => MudDialog.Cancel();
}
