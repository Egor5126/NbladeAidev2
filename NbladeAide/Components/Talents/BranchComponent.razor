@using Models.TalentsModels

<MudStack Justify="Justify.Center">
    <BranchCompressedInfo Branch="Branch" />
    <br />

    <MudNumericField T="int"
                     Value="Branch.InvestedPoints"
                     Label="Вложенные очки"
                     Variant="Variant.Outlined"
                     Min="0"
                     Max="@(Math.Min(AvailablePoints + Branch.InvestedPoints, Branch.MaxBranchPoints))"
                     HelperText="@($"Максимум: {Branch.MaxBranchPoints}")"
                     ValueChanged="UpdatePoints" />
</MudStack>

@code {
    [Parameter]
    public TalentBranch Branch { get; set; }

    [Parameter]
    public int AvailablePoints { get; set; }

    [Parameter]
    public EventCallback<TalentBranch> BranchChanged { get; set; }

    [Parameter]
    public EventCallback<int> AvailablePointsChanged { get; set; }

    public async Task UpdatePoints(int value)
    {
        var diff = value - Branch.InvestedPoints;
        AvailablePoints -= diff;
        Branch.InvestedPoints = value;
        await BranchChanged.InvokeAsync(Branch);
        await AvailablePointsChanged.InvokeAsync(AvailablePoints);
    }
}