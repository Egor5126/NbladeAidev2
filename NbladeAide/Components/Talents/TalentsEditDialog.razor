@using Models.TalentsModels

<MudDialog>
    <TitleContent>
        Изменение талантов
    </TitleContent>
    <DialogContent>
        <TalentsComponent @bind-Talents="Talents"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Talents Talents { get; set; }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Talents));
    }

    private void Cancel() => MudDialog.Cancel();
}